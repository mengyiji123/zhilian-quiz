# MySQL 8.0+
DATABASE_URL=mysql://quiz_user:change-me@127.0.0.1:3306/shuati
QUESTION_DATA_PATH=data/questions.json

# First startup creates this administrator when there are no users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_DISPLAY_NAME=管理员

# 32-byte key encoded as 64 hexadecimal characters. Used to encrypt the AI key.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=replace-with-64-hex-characters

API_PORT=3001
SESSION_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false
