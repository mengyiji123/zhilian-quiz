# MySQL 密码中的 @、:、/、# 等字符需要先进行 URL 编码。
DATABASE_URL=mysql://quiz_user:replace-with-url-encoded-password@127.0.0.1:3306/shuati
QUESTION_DATA_PATH=data/questions.json

# 仅在 users 表为空时创建初始管理员。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_DISPLAY_NAME=管理员

# 32 字节随机密钥的 64 位十六进制文本，用于加密 AI API Key。
APP_ENCRYPTION_KEY=replace-with-64-hex-characters

API_HOST=127.0.0.1
API_PORT=3001
SESSION_DAYS=30
COOKIE_SECURE=true
TRUST_PROXY=true
